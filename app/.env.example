# ============================================================
# HeroBook — variables d'environnement (copier vers .env.local)
# ============================================================

# Supabase (URL du projet + clé anon publique)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fournisseurs OAuth affichés sur /login et /register (ids Supabase,
# séparés par des virgules). Chaque fournisseur doit aussi être activé
# dans le dashboard Supabase (Auth → Providers).
#   google = Gmail/Google · azure = Microsoft (Outlook) · apple · github
NEXT_PUBLIC_AUTH_PROVIDERS=google,azure,apple,github

# RevenueCat — clé publique SDK (Dashboard RC → Settings → API Keys).
# Requise uniquement pour les achats natifs Android/iOS. Sans elle,
# la boutique reste en mode simulation (dev).
NEXT_PUBLIC_REVENUECAT_API_KEY=
